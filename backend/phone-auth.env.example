# Add these to the existing server environment; never overwrite existing SECRET_KEY or DATABASE_URL.
# Generate a separate random value at least 32 characters long; keep stable across deploys.
PHONE_OTP_SECRET=REPLACE_WITH_RANDOM_SECRET
TWILIO_ACCOUNT_SID=REPLACE_WITH_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_AUTH_TOKEN
# Use the approved Messaging Service OR sender number, not both unless your provider requires it.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
PHONE_SMS_DAILY_LIMIT=500
ALLOW_LEGACY_EMAIL_REGISTRATION=false
